rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User study documents folder: users/{userId}/{allPaths=**}
    match /users/{userId}/{allPaths=**} {
      // Authenticated user can read, download, or delete their own study files
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      
      // Upload check: authenticated user, max 25MB per document
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size <= 25 * 1024 * 1024;
    }

    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: false;
    }
  }
}
