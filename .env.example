# StudyAI - Frontend Environment Variables (Vercel / Local)
# Obtain Firebase values from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# NOTE: Never store server service account keys or the GROQ_API_KEY in frontend env files!
# Keep GROQ_API_KEY strictly in server/.env (never in browser code).

# Firebase Web Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend Server URL (e.g. Render / Cloud Run / Railway URL)
# For local development with Vite dev proxy, leave blank or set to http://localhost:5000
# For production on Vercel:
VITE_API_BASE_URL=https://your-backend-service.onrender.com
