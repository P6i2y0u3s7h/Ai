# StudyAI Server Environment Variables (Keep confidential - NEVER commit .env to Git)
PORT=5000

# AI Provider Configuration (Default: 'groq' for free-tier development)
AI_PROVIDER=groq

# Groq Cloud API Configuration (Free Tier: https://console.groq.com/keys)
# Supported free-tier models:
# - llama-3.3-70b-versatile (Recommended default: 30 RPM, 6,000 TPM, 1,000 RPD, 100k TPD)
# - llama-3.1-8b-instant     (High throughput: 30 RPM, 14,400 RPD, 500k TPD)
# - mixtral-8x7b-32768       (30 RPM, 5,000 TPM)
# - gemma2-9b-it             (30 RPM, 15,000 TPM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative Provider (Optional, only if AI_PROVIDER=xai)
XAI_API_KEY=
XAI_MODEL=grok-beta

# Firebase Configuration
FIREBASE_PROJECT_ID=ai-chatbot-c21ae
FIREBASE_STORAGE_BUCKET=ai-chatbot-c21ae.firebasestorage.app

# Firebase Service Account JSON (Optional for local if using projectId/emulator, recommended for production cloud environments)
# Single line JSON string: {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT=

# Allowed Frontend Origins (comma-separated, *.vercel.app is automatically supported)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-app.vercel.app
